# --- Database ---------------------------------------------------------------
# Postgres 14+ . `pnpm db:reset && pnpm db:seed` creates the schema and loads
# the demonstration dataset.
DATABASE_URL=postgres://saveus:saveus@127.0.0.1:5432/saveus
# Used only by the API test suite, which drops and recreates the schema.
TEST_DATABASE_URL=postgres://saveus:saveus@127.0.0.1:5432/saveus_test

# --- Sessions ---------------------------------------------------------------
# Signs the session cookie. Generate one with: openssl rand -base64 32
APP_SECRET=change-me-to-a-long-random-string

# --- AI provider (optional) -------------------------------------------------
# With no key set, the platform runs on the deterministic corpus provider:
# agents retrieve and recombine records that are already in the database and
# write UNKNOWN where the record is empty. Everything works; the language is
# duller and completely checkable.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# Force the offline provider even when a key is present:
# AI_PROVIDER=deterministic

# --- Queue (optional) -------------------------------------------------------
# Without REDIS_URL the worker runs on an in-memory queue, which is fine for a
# single-machine deployment.
# REDIS_URL=redis://127.0.0.1:6379

# --- Live intake (optional) -------------------------------------------------
# Off by default. Without it the pipeline runs against seeded connectors and
# exercises exactly the same code path, so tests and CI never touch the network.
# Turning it on makes the worker fetch real feeds once a day.
# INTAKE_LIVE=true
# UTC hour for the daily cycle. Default 5.
# INTAKE_HOUR_UTC=5
# Sent on every outbound request. Put a real contact address in it: publishers
# are entitled to know who is fetching them and how to ask us to stop.
# INTAKE_USER_AGENT=save-us-intake/0.1 (+https://example.org/intake; ops@example.org)

# --- Google sign-in (optional) ----------------------------------------------
# Leave unset and the sign-in page simply does not offer Google; handle sign-in
# keeps working. Half-configured counts as unconfigured.
#
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application), and register this exact redirect URI:
#   <PUBLIC_APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# Public origin of the web app. Used to build the redirect URI above and to
# bound where a completed sign-in is allowed to return to.
PUBLIC_APP_URL=http://localhost:3000

# --- API server (only when running apps/api standalone) ---------------------
PORT=3001
