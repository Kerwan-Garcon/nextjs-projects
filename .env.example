# --- Database ---------------------------------------------------------------
# Postgres 14+ . `pnpm db:reset && pnpm db:seed` creates the schema and loads
# the demonstration dataset.
DATABASE_URL=postgres://saveus:saveus@127.0.0.1:5432/saveus
# Used only by the API test suite, which drops and recreates the schema.
TEST_DATABASE_URL=postgres://saveus:saveus@127.0.0.1:5432/saveus_test

# --- Sessions ---------------------------------------------------------------
# Signs the session cookie. Generate one with: openssl rand -base64 32
APP_SECRET=change-me-to-a-long-random-string

# --- AI provider (optional) -------------------------------------------------
# With no key set, the platform runs on the deterministic corpus provider:
# agents retrieve and recombine records that are already in the database and
# write UNKNOWN where the record is empty. Everything works; the language is
# duller and completely checkable.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# Force the offline provider even when a key is present:
# AI_PROVIDER=deterministic

# --- Queue (optional) -------------------------------------------------------
# Without REDIS_URL the worker runs on an in-memory queue, which is fine for a
# single-machine deployment.
# REDIS_URL=redis://127.0.0.1:6379

# --- API server (only when running apps/api standalone) ---------------------
PORT=3001
