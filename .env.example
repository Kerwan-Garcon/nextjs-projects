# --- Database ---------------------------------------------------------------
# Postgres 14+ . `pnpm db:reset && pnpm db:seed` creates the schema and loads
# the demonstration dataset.
DATABASE_URL=postgres://saveus:saveus@127.0.0.1:5432/saveus
# TLS is decided by the host: on for anything not on this machine, off for
# localhost. Set it explicitly to overrule the guess in either direction.
# DATABASE_SSL=true
# Verify the server certificate. Off by default because Neon, Supabase and
# Render all terminate TLS with their own CA.
# DATABASE_SSL_STRICT=true
# Defaults to 10, or 1 on a serverless platform where every invocation is its
# own process and a managed free tier counts connections.
# DATABASE_POOL_SIZE=10
# Used only by the API test suite, which drops and recreates the schema.
TEST_DATABASE_URL=postgres://saveus:saveus@127.0.0.1:5432/saveus_test

# --- Sessions ---------------------------------------------------------------
# Signs the session cookie. Generate one with: openssl rand -base64 32
# The app refuses to start in production while this is still the documented
# default value - a deployment signing sessions with a published key is one
# anybody can mint a session for.
APP_SECRET=change-me-to-a-long-random-string

# --- AI provider (optional) -------------------------------------------------
# With no key set, the platform runs on the deterministic corpus provider:
# agents retrieve and recombine records that are already in the database and
# write UNKNOWN where the record is empty. Everything works; the language is
# duller and completely checkable.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# Force the offline provider even when a key is present:
# AI_PROVIDER=deterministic

# --- Rate limiting ----------------------------------------------------------
# Counters live in Postgres by default, because a counter in process memory is
# not a limit on any deployment with more than one process - and on a serverless
# host every invocation starts with an empty one. Set this to `memory` only for
# a single long-running server that wants to avoid the round trip.
# RATE_LIMIT_DRIVER=postgres

# --- Model API (optional) ---------------------------------------------------
# The API rate-limits. The SDK backs off exponentially and honours the
# `retry-after` it is given; these bound how long it keeps trying.
# ANTHROPIC_MAX_RETRIES=4
# ANTHROPIC_TIMEOUT_MS=120000

# --- Queue (optional) -------------------------------------------------------
# Without REDIS_URL the worker runs on an in-memory queue, which is fine for a
# single-machine deployment.
# REDIS_URL=redis://127.0.0.1:6379

# --- Scheduled intake over HTTP (serverless deployments) --------------------
# On a platform with no long-running process, the daily cycle is triggered by
# the platform's scheduler calling GET /api/cron/intake. Without this secret the
# endpoint returns 404: an open endpoint that makes the platform fetch a dozen
# other people's servers is a denial-of-service tool aimed at publishers.
# Sent as `Authorization: Bearer <secret>` or `X-Cron-Secret: <secret>`.
# CRON_SECRET=generate-another-long-random-string
# How long one triggered cycle may take. The cycle stops between connectors
# inside this budget and reports what it did not reach; whatever is skipped is
# first in line on the next run. Keep it under the platform's function limit.
# INTAKE_BUDGET_MS=55000

# --- Live intake (optional) -------------------------------------------------
# Off by default. Without it the pipeline runs against seeded connectors and
# exercises exactly the same code path, so tests and CI never touch the network.
# Turning it on makes the worker fetch real feeds once a day.
# INTAKE_LIVE=true
# UTC hour for the daily cycle. Default 5.
# INTAKE_HOUR_UTC=5
# Sent on every outbound request. Put a real contact address in it: publishers
# are entitled to know who is fetching them and how to ask us to stop.
# INTAKE_USER_AGENT=save-us-intake/0.1 (+https://example.org/intake; ops@example.org)

# --- Google sign-in (optional) ----------------------------------------------
# Leave unset and the sign-in page simply does not offer Google; handle sign-in
# keeps working. Half-configured counts as unconfigured.
#
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application), and register this exact redirect URI:
#   <PUBLIC_APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# Public origin of the web app. Used to build the redirect URI above and to
# bound where a completed sign-in is allowed to return to.
PUBLIC_APP_URL=http://localhost:3000

# --- API server (only when running apps/api standalone) ---------------------
PORT=3001
